# ================================
# MICHAELCROWE.AI - Environment Variables
# ================================
# Copy this file to .env.local and fill in your actual keys

# ================================
# AI CHAT (DeepSeek)
# ================================
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ================================
# PAYMENT PROCESSING (Stripe)
# ================================
# Get your keys from: https://dashboard.stripe.com/apikeys
# IMPORTANT: Use test keys for development, live keys for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret (for handling payment events)
# Get this after creating a webhook endpoint in Stripe dashboard
# Point webhook to: https://yourdomain.com/api/checkout/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ================================
# EMAIL SERVICE (Resend)
# ================================
# Get your API key from: https://resend.com/api-keys
# Verify your domain first: https://resend.com/domains
RESEND_API_KEY=re_your_resend_api_key_here

# ================================
# CRM (HubSpot) - OPTIONAL
# ================================
# Get your API key from: https://app.hubspot.com/private-apps
# Leave empty to skip HubSpot integration
HUBSPOT_API_KEY=your_hubspot_api_key_here

# ================================
# CALENDAR BOOKING (Cal.com) - OPTIONAL
# ================================
# Get your API key from: https://app.cal.com/settings/developer/api-keys
# Leave empty to handle bookings manually
CAL_COM_API_KEY=your_calcom_api_key_here

# ================================
# ANALYTICS (Optional)
# ================================
# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog (if using)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ================================
# SETUP CHECKLIST
# ================================
#
# 1. REQUIRED - DeepSeek API:
#    - Sign up at https://platform.deepseek.com/
#    - Create API key
#    - Add credits to your account
#
# 2. REQUIRED - Stripe:
#    - Sign up at https://stripe.com
#    - Get test API keys from dashboard
#    - Test checkout flow
#    - Switch to live keys when ready for production
#    - Set up webhook endpoint for payment events
#
# 3. REQUIRED - Resend:
#    - Sign up at https://resend.com
#    - Verify your domain (critical for deliverability)
#    - Create API key
#    - Test email sending
#
# 4. RECOMMENDED - HubSpot:
#    - Sign up for free at https://hubspot.com
#    - Create private app in settings
#    - Grant contacts and deals permissions
#    - Copy API key
#
# 5. OPTIONAL - Cal.com:
#    - Sign up at https://cal.com
#    - Connect your calendar (Google/Outlook)
#    - Create event types (30min discovery, 2hr strategy, etc.)
#    - Generate API key
#
# 6. Deploy to Vercel:
#    - Add all environment variables in Vercel project settings
#    - Redeploy after adding new variables
#
# ================================
# REVENUE IMPACT
# ================================
#
# With these integrations, you enable:
# - Instant payments: +$15-30K/month (remove friction)
# - Auto email follow-up: +20-40% conversions
# - CRM tracking: Better lead nurturing
# - Calendar booking: 30-50% more meetings booked
#
